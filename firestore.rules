rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HARDENED PRIMITIVES ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token &&
         request.auth.token.email == 'abdulbarik80000@gmail.com' &&
         'email_verified' in request.auth.token &&
         request.auth.token.email_verified == true)
      );
    }

    // Backend enforcement of account suspensions and permanent bans
    function isNotRestricted() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountStatus in ['active', 'warned']);
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---

    function isValidUserProfile(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.username is string && data.username.size() >= 3 && data.username.size() <= 30 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             data.bio is string && data.bio.size() <= 250 &&
             data.avatarUrl is string && data.avatarUrl.size() <= 500 &&
             data.vipLevel is int && data.vipLevel >= 1 && data.vipLevel <= 50 &&
             data.vipXp is int && data.vipXp >= 0 &&
             data.diamondBalance is int && data.diamondBalance >= 0 &&
             data.followersCount is int && data.followersCount >= 0 &&
             data.followingCount is int && data.followingCount >= 0 &&
             data.eligibleVideoViews is int && data.eligibleVideoViews >= 0 &&
             data.eligibleReelViews is int && data.eligibleReelViews >= 0 &&
             data.eligiblePhotoViews is int && data.eligiblePhotoViews >= 0 &&
             data.invalidViewsCount is int && data.invalidViewsCount >= 0 &&
             data.pendingEarningsPaise is int && data.pendingEarningsPaise >= 0 &&
             data.approvedEarningsPaise is int && data.approvedEarningsPaise >= 0 &&
             data.paidEarningsPaise is int && data.paidEarningsPaise >= 0 &&
             data.accountStatus is string && data.accountStatus in ['active', 'warned', 'suspended', 'banned'] &&
             data.statusReason is string && data.statusReason.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMediaPost(data) {
      return data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.postType is string && data.postType in ['video', 'reel', 'photo'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.description is string && data.description.size() <= 1000 &&
             data.hashtags is string && data.hashtags.size() <= 200 &&
             data.mediaCount is int && data.mediaCount >= 1 && data.mediaCount <= 10 &&
             data.mediaUri is string && data.mediaUri.size() <= 500 &&
             data.thumbnailTitle is string && data.thumbnailTitle.size() <= 120 &&
             data.durationSeconds is int && data.durationSeconds >= 0 && data.durationSeconds <= 7200 &&
             data.viewsCount is int && data.viewsCount >= 0 &&
             data.likesCount is int && data.likesCount >= 0 &&
             data.commentsCount is int && data.commentsCount >= 0 &&
             data.sharesCount is int && data.sharesCount >= 0 &&
             data.visibility is string && data.visibility in ['public', 'removed'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPostViewRecord(data) {
      return data.postId is string && isValidId(data.postId) &&
             data.viewerId is string && isValidId(data.viewerId) &&
             data.postType is string && data.postType in ['video', 'reel', 'photo'] &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidPostComment(data) {
      return data.postId is string && isValidId(data.postId) &&
             data.authorId is string && isValidId(data.authorId) &&
             data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidUserFollow(data) {
      return data.followerId is string && isValidId(data.followerId) &&
             data.targetUserId is string && isValidId(data.targetUserId) &&
             data.followerId != data.targetUserId &&
             data.targetName is string && data.targetName.size() >= 1 && data.targetName.size() <= 60 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLiveStream(data) {
      return data.hostId is string && isValidId(data.hostId) &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.streamCategory is string && data.streamCategory.size() >= 1 && data.streamCategory.size() <= 50 &&
             data.status is string && data.status in ['live', 'pk_battle', 'ended'] &&
             data.viewerCount is int && data.viewerCount >= 0 &&
             data.isPkBattle is bool &&
             data.opponentId is string && data.opponentId.size() <= 128 &&
             data.opponentName is string && data.opponentName.size() <= 60 &&
             data.hostPkScore is int && data.hostPkScore >= 0 &&
             data.opponentPkScore is int && data.opponentPkScore >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveChatMessage(data) {
      return data.streamId is string && isValidId(data.streamId) &&
             data.senderId is string && isValidId(data.senderId) &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.messageText is string && data.messageText.size() >= 1 && data.messageText.size() <= 300 &&
             data.isGiftAlert is bool &&
             data.giftAmountDiamonds is int && data.giftAmountDiamonds >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidWalletTransaction(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.txType is string && data.txType in ['diamond_purchase', 'gift_sent', 'pk_battle_gift'] &&
             data.packageId is string && data.packageId.size() >= 1 && data.packageId.size() <= 60 &&
             data.diamondsDelta is int && data.diamondsDelta != 0 &&
             data.amountInrPaise is int && data.amountInrPaise >= 0 &&
             data.recipientId is string && data.recipientId.size() <= 128 &&
             data.streamId is string && data.streamId.size() <= 128 &&
             data.verificationStatus is string && data.verificationStatus in ['pending_backend_verification', 'verified', 'rejected'] &&
             data.paymentRef is string && data.paymentRef.size() >= 1 && data.paymentRef.size() <= 120 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidBankAccount(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.accountHolderName is string && data.accountHolderName.size() >= 2 && data.accountHolderName.size() <= 80 &&
             data.bankName is string && data.bankName.size() >= 2 && data.bankName.size() <= 80 &&
             data.accountNumberMasked is string && data.accountNumberMasked.size() >= 4 && data.accountNumberMasked.size() <= 30 &&
             data.ifscCode is string && data.ifscCode.size() >= 4 && data.ifscCode.size() <= 20 &&
             data.verificationStatus is string && data.verificationStatus in ['pending', 'verified', 'rejected'] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWithdrawalRequest(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.bankAccountId is string && isValidId(data.bankAccountId) &&
             data.amountInrPaise is int && data.amountInrPaise >= 1000000 &&
             data.userVipLevelAtRequest is int && data.userVipLevelAtRequest >= 30 &&
             data.status is string && data.status in ['pending_review', 'approved', 'paid', 'rejected'] &&
             data.scheduledPayoutDay is int && data.scheduledPayoutDay == 18 &&
             data.adminNote is string && data.adminNote.size() <= 300 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidModerationReport(data) {
      return data.reporterId is string && isValidId(data.reporterId) &&
             data.targetType is string && data.targetType in ['photo', 'video', 'reel', 'live_stream', 'user_profile', 'chat_message'] &&
             data.targetId is string && isValidId(data.targetId) &&
             data.reasonCategory is string && data.reasonCategory in ['explicit_content', 'illegal_content', 'harassment', 'threats_danger', 'impersonation_scam', 'copyright'] &&
             data.details is string && data.details.size() >= 1 && data.details.size() <= 500 &&
             data.status is string && data.status in ['open', 'actioned', 'dismissed', 'appealed'] &&
             data.moderationAction is string && data.moderationAction.size() <= 100 &&
             data.appealText is string && data.appealText.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSupportTicket(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.category is string && data.category in ['login_problems', 'video_upload_problems', 'live_streaming_problems', 'diamond_payment_problems', 'earnings_withdrawal', 'account_bans_appeals', 'other_issues'] &&
             data.subject is string && data.subject.size() >= 3 && data.subject.size() <= 120 &&
             data.message is string && data.message.size() >= 5 && data.message.size() <= 1000 &&
             data.status is string && data.status in ['open', 'in_progress', 'resolved', 'closed'] &&
             data.adminReply is string && data.adminReply.size() <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidUserNotification(data) {
      return data.userId is string && isValidId(data.userId) &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 400 &&
             data.notifType is string && data.notifType in ['live', 'follow', 'gift', 'moderation', 'system'] &&
             data.isRead is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- COLLECTION MATCH RULES ---

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().accountStatus == 'active' &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'displayName', 'bio', 'avatarUrl', 'vipLevel', 'vipXp',
                         'diamondBalance', 'followersCount', 'followingCount', 'eligibleVideoViews',
                         'eligibleReelViews', 'eligiblePhotoViews', 'invalidViewsCount',
                         'pendingEarningsPaise', 'approvedEarningsPaise', 'paidEarningsPaise',
                         'accountStatus', 'statusReason', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'displayName', 'bio', 'avatarUrl', 'vipLevel', 'vipXp',
                         'diamondBalance', 'followersCount', 'followingCount', 'eligibleVideoViews',
                         'eligibleReelViews', 'eligiblePhotoViews', 'invalidViewsCount',
                         'pendingEarningsPaise', 'approvedEarningsPaise', 'paidEarningsPaise',
                         'accountStatus', 'statusReason', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Owner updates profile, VIP progress, diamond spend, or view/earnings counters (cannot alter accountStatus or paidEarningsPaise)
                         (request.auth.uid == userId &&
                          existing().accountStatus in ['active', 'warned'] &&
                          incoming().accountStatus == existing().accountStatus &&
                          incoming().statusReason == existing().statusReason &&
                          incoming().paidEarningsPaise == existing().paidEarningsPaise &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'username', 'displayName', 'bio', 'avatarUrl', 'vipLevel', 'vipXp',
                            'diamondBalance', 'followersCount', 'followingCount',
                            'eligibleVideoViews', 'eligibleReelViews', 'eligiblePhotoViews',
                            'invalidViewsCount', 'pendingEarningsPaise', 'approvedEarningsPaise', 'updatedAt'
                          ])) ||
                         // Action 2: Admin moderation / payout / VIP management
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly([
                            'vipLevel', 'vipXp', 'diamondBalance', 'pendingEarningsPaise',
                            'approvedEarningsPaise', 'paidEarningsPaise', 'accountStatus',
                            'statusReason', 'updatedAt'
                          ]))
                       );

      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.authorId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(postId) &&
                       incoming().authorId == request.auth.uid &&
                       incoming().visibility == 'public' &&
                       incoming().keys().hasAll([
                         'authorId', 'authorName', 'postType', 'title', 'description', 'hashtags',
                         'mediaCount', 'mediaUri', 'thumbnailTitle', 'durationSeconds', 'viewsCount',
                         'likesCount', 'commentsCount', 'sharesCount', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'authorId', 'authorName', 'postType', 'title', 'description', 'hashtags',
                         'mediaCount', 'mediaUri', 'thumbnailTitle', 'durationSeconds', 'viewsCount',
                         'likesCount', 'commentsCount', 'sharesCount', 'visibility', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidMediaPost(incoming()) &&
                       isNotRestricted();

      allow update: if isSignedIn() &&
                       isValidId(postId) &&
                       isValidMediaPost(incoming()) &&
                       incoming().authorId == existing().authorId &&
                       incoming().postType == existing().postType &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Author updates metadata
                         (request.auth.uid == existing().authorId &&
                          existing().visibility == 'public' &&
                          incoming().visibility == 'public' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'hashtags', 'updatedAt'])) ||
                         // Action 2: Authenticated engagement counters (views, likes, comments, shares)
                         (existing().visibility == 'public' &&
                          incoming().visibility == 'public' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'commentsCount', 'sharesCount', 'updatedAt'])) ||
                         // Action 3: Admin moderation (remove violating content)
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['visibility', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(postId) && (resource.data.authorId == request.auth.uid || isAdmin());

      // Anti-Fraud Unique View Ledger Subcollection
      match /views/{viewerId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(viewerId) && (request.auth.uid == viewerId || isAdmin());
        allow list: if isSignedIn() && isValidId(postId) && (resource.data.viewerId == request.auth.uid || isAdmin());

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(viewerId) &&
                         request.auth.uid == viewerId &&
                         incoming().viewerId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'viewerId', 'postType', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'viewerId', 'postType', 'createdAt']) &&
                         isValidPostViewRecord(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId));

        allow update, delete: if false;
      }

      // Post Comments Subcollection
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId);
        allow list: if isSignedIn() && isValidId(postId) && resource.data.postId == postId;

        allow create: if isSignedIn() &&
                         isValidId(postId) &&
                         isValidId(commentId) &&
                         incoming().authorId == request.auth.uid &&
                         incoming().postId == postId &&
                         incoming().keys().hasAll(['postId', 'authorId', 'authorName', 'text', 'createdAt']) &&
                         incoming().keys().hasOnly(['postId', 'authorId', 'authorName', 'text', 'createdAt']) &&
                         isValidPostComment(incoming()) &&
                         exists(/databases/$(database)/documents/posts/$(postId)) &&
                         isNotRestricted();

        allow update: if false;
        allow delete: if isSignedIn() && isValidId(postId) && isValidId(commentId) && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    match /follows/{followId} {
      allow get: if isSignedIn() && isValidId(followId) && (resource.data.followerId == request.auth.uid || resource.data.targetUserId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.followerId == request.auth.uid || resource.data.targetUserId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(followId) &&
                       incoming().followerId == request.auth.uid &&
                       incoming().keys().hasAll(['followerId', 'targetUserId', 'targetName', 'createdAt']) &&
                       incoming().keys().hasOnly(['followerId', 'targetUserId', 'targetName', 'createdAt']) &&
                       isValidUserFollow(incoming());

      allow update: if false;
      allow delete: if isSignedIn() && isValidId(followId) && resource.data.followerId == request.auth.uid;
    }

    match /live_streams/{streamId} {
      allow get: if isSignedIn() && isValidId(streamId) && (resource.data.status in ['live', 'pk_battle'] || resource.data.hostId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.status in ['live', 'pk_battle'] || resource.data.hostId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(streamId) &&
                       incoming().hostId == request.auth.uid &&
                       incoming().status in ['live', 'pk_battle'] &&
                       incoming().keys().hasAll([
                         'hostId', 'hostName', 'title', 'streamCategory', 'status', 'viewerCount',
                         'isPkBattle', 'opponentId', 'opponentName', 'hostPkScore', 'opponentPkScore',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'hostId', 'hostName', 'title', 'streamCategory', 'status', 'viewerCount',
                         'isPkBattle', 'opponentId', 'opponentName', 'hostPkScore', 'opponentPkScore',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidLiveStream(incoming()) &&
                       isNotRestricted();

      // Terminal State Locking: Once status == 'ended', non-admins cannot update the stream
      allow update: if isSignedIn() &&
                       isValidId(streamId) &&
                       isValidLiveStream(incoming()) &&
                       incoming().hostId == existing().hostId &&
                       incoming().createdAt == existing().createdAt && (
                         isAdmin() ||
                         (existing().status != 'ended' && (
                           // Action 1: Host controls PK battle state or ends broadcast
                           (request.auth.uid == existing().hostId &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'title', 'status', 'isPkBattle', 'opponentId', 'opponentName',
                              'hostPkScore', 'opponentPkScore', 'viewerCount', 'updatedAt'
                            ])) ||
                           // Action 2: Viewer joins/leaves or sends verified PK gift score increment
                           (incoming().status == existing().status &&
                            incoming().diff(existing()).affectedKeys().hasOnly([
                              'viewerCount', 'hostPkScore', 'opponentPkScore', 'updatedAt'
                            ]))
                         ))
                       );

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(streamId) && isValidId(messageId);
        allow list: if isSignedIn() && isValidId(streamId) && resource.data.streamId == streamId;

        allow create: if isSignedIn() &&
                         isValidId(streamId) &&
                         isValidId(messageId) &&
                         incoming().senderId == request.auth.uid &&
                         incoming().streamId == streamId &&
                         incoming().keys().hasAll([
                           'streamId', 'senderId', 'senderName', 'messageText',
                           'isGiftAlert', 'giftAmountDiamonds', 'createdAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'streamId', 'senderId', 'senderName', 'messageText',
                           'isGiftAlert', 'giftAmountDiamonds', 'createdAt'
                         ]) &&
                         isValidLiveChatMessage(incoming()) &&
                         exists(/databases/$(database)/documents/live_streams/$(streamId)) &&
                         isNotRestricted();

        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    match /wallet_transactions/{txId} {
      allow get: if isSignedIn() && isValidId(txId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Diamond purchases created by client MUST have verificationStatus == 'pending_backend_verification'
      allow create: if isSignedIn() &&
                       isValidId(txId) &&
                       incoming().userId == request.auth.uid &&
                       ((incoming().txType == 'diamond_purchase' && incoming().verificationStatus == 'pending_backend_verification' && incoming().diamondsDelta > 0) ||
                        (incoming().txType in ['gift_sent', 'pk_battle_gift'] && incoming().verificationStatus == 'verified' && incoming().diamondsDelta < 0)) &&
                       incoming().keys().hasAll([
                         'userId', 'txType', 'packageId', 'diamondsDelta', 'amountInrPaise',
                         'recipientId', 'streamId', 'verificationStatus', 'paymentRef', 'createdAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'txType', 'packageId', 'diamondsDelta', 'amountInrPaise',
                         'recipientId', 'streamId', 'verificationStatus', 'paymentRef', 'createdAt'
                       ]) &&
                       isValidWalletTransaction(incoming());

      // Only Admin / Backend verifier can update verificationStatus
      allow update: if isSignedIn() &&
                       isValidId(txId) &&
                       isValidWalletTransaction(incoming()) &&
                       isAdmin() &&
                       existing().verificationStatus == 'pending_backend_verification' &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus']);

      allow delete: if false;
    }

    match /bank_accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(accountId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().verificationStatus == 'pending' &&
                       incoming().keys().hasAll([
                         'userId', 'accountHolderName', 'bankName', 'accountNumberMasked',
                         'ifscCode', 'verificationStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'accountHolderName', 'bankName', 'accountNumberMasked',
                         'ifscCode', 'verificationStatus', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidBankAccount(incoming());

      allow update: if isSignedIn() &&
                       isValidId(accountId) &&
                       isValidBankAccount(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt && (
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['verificationStatus', 'updatedAt'])) ||
                         (request.auth.uid == existing().userId &&
                          existing().verificationStatus == 'pending' &&
                          incoming().verificationStatus == 'pending' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['accountHolderName', 'bankName', 'accountNumberMasked', 'ifscCode', 'updatedAt']))
                       );

      allow delete: if isSignedIn() && isValidId(accountId) && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /withdrawals/{withdrawalId} {
      allow get: if isSignedIn() && isValidId(withdrawalId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Client can only submit 'pending_review' withdrawal if Level >= 30, amount >= Rs 10,000, and bank account is verified
      allow create: if isSignedIn() &&
                       isValidId(withdrawalId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'pending_review' &&
                       incoming().keys().hasAll([
                         'userId', 'bankAccountId', 'amountInrPaise', 'userVipLevelAtRequest',
                         'status', 'scheduledPayoutDay', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'bankAccountId', 'amountInrPaise', 'userVipLevelAtRequest',
                         'status', 'scheduledPayoutDay', 'adminNote', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidWithdrawalRequest(incoming()) &&
                       exists(/databases/$(database)/documents/bank_accounts/$(incoming().bankAccountId)) &&
                       get(/databases/$(database)/documents/bank_accounts/$(incoming().bankAccountId)).data.userId == request.auth.uid &&
                       get(/databases/$(database)/documents/bank_accounts/$(incoming().bankAccountId)).data.verificationStatus == 'verified';

      // Never allow ordinary user to mark a withdrawal as paid; only authorized admin can update status
      allow update: if isSignedIn() &&
                       isValidId(withdrawalId) &&
                       isValidWithdrawalRequest(incoming()) &&
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().bankAccountId == existing().bankAccountId &&
                       incoming().amountInrPaise == existing().amountInrPaise &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminNote', 'updatedAt']);

      allow delete: if false;
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.reporterId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       incoming().reporterId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().moderationAction == '' &&
                       incoming().keys().hasAll([
                         'reporterId', 'targetType', 'targetId', 'reasonCategory', 'details',
                         'status', 'moderationAction', 'appealText', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'reporterId', 'targetType', 'targetId', 'reasonCategory', 'details',
                         'status', 'moderationAction', 'appealText', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidModerationReport(incoming());

      allow update: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidModerationReport(incoming()) &&
                       incoming().reporterId == existing().reporterId &&
                       incoming().targetType == existing().targetType &&
                       incoming().targetId == existing().targetId &&
                       incoming().createdAt == existing().createdAt && (
                         // Action 1: Reporter submits an appeal
                         (request.auth.uid == existing().reporterId &&
                          incoming().status == 'appealed' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'appealText', 'updatedAt'])) ||
                         // Action 2: Admin reviews report or appeal
                         (isAdmin() &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'moderationAction', 'updatedAt']))
                       );

      allow delete: if isAdmin();
    }

    match /support_tickets/{ticketId} {
      allow get: if isSignedIn() && isValidId(ticketId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(ticketId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().status == 'open' &&
                       incoming().adminReply == '' &&
                       incoming().keys().hasAll([
                         'userId', 'category', 'subject', 'message',
                         'status', 'adminReply', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'category', 'subject', 'message',
                         'status', 'adminReply', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSupportTicket(incoming());

      allow update: if isSignedIn() &&
                       isValidId(ticketId) &&
                       isValidSupportTicket(incoming()) &&
                       isAdmin() &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminReply', 'updatedAt']);

      allow delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
                       isValidId(notificationId) &&
                       (incoming().userId == request.auth.uid || isAdmin()) &&
                       incoming().keys().hasAll(['userId', 'title', 'body', 'notifType', 'isRead', 'createdAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'body', 'notifType', 'isRead', 'createdAt']) &&
                       isValidUserNotification(incoming());

      allow update: if isSignedIn() &&
                       isValidId(notificationId) &&
                       isValidUserNotification(incoming()) &&
                       request.auth.uid == existing().userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);

      allow delete: if isSignedIn() && isValidId(notificationId) && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
